{
  "name": "simple-gql-caching-rproxy",
  "version": "1.0.0",
  "description": "Bounded in-memory caching reverse proxy for GraphQL queries",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env watch ./src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:e2e": "tsx --test test/api.e2e.test.ts",
    "start": "node dist/index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fastify": "^5.12.0",
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
